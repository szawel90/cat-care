generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  REVIEWER
  ADMIN
}

enum AccessStatus {
  ACTIVE
  REVOKED
}

enum ThemePreference {
  system
  light
  dark
}

enum LanguagePreference {
  system
  en
  pl
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique
  emailVerified      Boolean            @default(false)
  displayName        String
  image              String?
  role               UserRole           @default(USER)
  themePreference    ThemePreference    @default(system)
  languagePreference LanguagePreference @default(system)
  consentVersion     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  accounts           AuthAccount[]
  sessions           AuthSession[]
  accessApproval     AccessApproval?
  emailActions       EmailAction[]
  cats               Cat[]
  households         Household[]
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AccessApproval {
  id        String       @id @default(uuid()) @db.Uuid
  email     String       @unique
  userId    String?      @unique @db.Uuid
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    AccessStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model AuthRateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model EmailAction {
  tokenHash   String   @id
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetEmail String
  expiresAt   DateTime

  @@index([userId])
}

model Household {
  id        String             @id @default(uuid()) @db.Uuid
  ownerId   String             @db.Uuid
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  version   Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  cats      Cat[]
  versions  HouseholdVersion[]

  @@unique([id, ownerId])
  @@index([ownerId])
}

model HouseholdVersion {
  id           String    @id @default(uuid()) @db.Uuid
  householdId  String    @db.Uuid
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  version      Int
  facts        Json
  environment  Json
  members      Json
  changeKind   String
  isCurrent    Boolean   @default(true)
  recordedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@unique([householdId, version])
}

model Cat {
  id               String             @id @default(uuid()) @db.Uuid
  ownerId          String             @db.Uuid
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  householdId      String             @db.Uuid
  household        Household          @relation(fields: [householdId, ownerId], references: [id, ownerId], onDelete: Cascade)
  version          Int                @default(0)
  portraitRevision Int                @default(0)
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  portraits        PortraitRevision[]
  versions         CatVersion[]

  @@index([ownerId])
  @@index([householdId, ownerId])
}

model CatVersion {
  id           String    @id @default(uuid()) @db.Uuid
  catId        String    @db.Uuid
  cat          Cat       @relation(fields: [catId], references: [id], onDelete: Cascade)
  version      Int
  name         String    @db.VarChar(60)
  householdId  String    @db.Uuid
  photo        Bytes?
  photoVersion Int       @default(0)
  attributes   Json
  events       Json
  archived     Boolean   @default(false)
  changeKind   String
  isCurrent    Boolean   @default(true)
  recordedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@unique([catId, version])
}

model PortraitRevision {
  id                 String   @id @default(uuid()) @db.Uuid
  catId              String   @db.Uuid
  cat                Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  revision           Int
  assessmentId       String   @db.Uuid
  respondentId       String   @db.Uuid
  rulesVersion       String
  periodStart        DateTime @db.Date
  periodEnd          DateTime @db.Date
  answers            Json
  followups          Json
  issuedFollowups    Json
  householdSnapshot  Json
  prefilledQuestions Json
  result             Json
  isCurrent          Boolean  @default(true)
  recordedAt         DateTime @default(now())
  supersededAt       DateTime?
  contextChangedAt   DateTime?

  @@unique([catId, revision])
  @@index([catId, assessmentId])
}
