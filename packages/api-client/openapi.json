  "info": {
    "title": "Cat Care API",
    "description": "Cat Care service contract.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "not_ready"]
          }
        },
        "required": ["status"]
      },
      "AccountOptionsDto": {
        "type": "object",
        "properties": {
          "google": {
            "type": "boolean"
          },
          "facebook": {
            "type": "boolean"
          },
          "emailPassword": {
            "type": "boolean"
          }
        },
        "required": ["google", "facebook", "emailPassword"]
      },
      "AccountProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": ["id", "displayName", "email", "emailVerified"]
      },
      "AccountPreferencesDto": {
        "type": "object",
        "properties": {
          "themePreference": {
            "type": "string",
            "enum": ["system", "light", "dark"]
          },
          "languagePreference": {
            "type": "string",
            "enum": ["system", "en", "pl"]
          }
        },
        "required": ["themePreference", "languagePreference"]
      },
      "UpdateAccountPreferencesDto": {
        "type": "object",
        "properties": {
          "themePreference": {
            "type": "string",
            "enum": ["system", "light", "dark"]
          },
          "languagePreference": {
            "type": "string",
            "enum": ["system", "en", "pl"]
          }
        }
      },
      "BarfRecipeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currentVersion": {
            "type": "number"
          },
          "archivedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
