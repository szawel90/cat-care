    "/v1/account/options": {
      "get": {
        "operationId": "AccountController_options",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOptionsDto"
                }
              }
            }
          }
        },
        "tags": ["Account"]
      }
    },
    "/v1/account": {
      "get": {
        "operationId": "AccountController_profile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountProfileDto"
                }
              }
            }
          }
        },
        "tags": ["Account"]
      }
    },
    "/v1/account/preferences": {
      "get": {
        "operationId": "AccountController_preferences",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPreferencesDto"
                }
              }
            }
          }
        },
        "tags": ["Account"]
      },
      "post": {
        "operationId": "AccountController_updatePreferences",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAccountPreferencesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPreferencesDto"
                }
              }
            }
          }
        },
        "tags": ["Account"]
      }
    },
    "/v1/account/export": {
      "get": {
        "operationId": "AccountController_export",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountExportDto"
                }
              }
